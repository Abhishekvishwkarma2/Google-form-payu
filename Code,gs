// ==========================================================
// 4. CREATE PAYMENT
// ==========================================================

function createPayment(data) {

  try {

    // ------------------------------------------------------
    // GET FORM DATA
    // ------------------------------------------------------

    const patientName =
      String(data.patientName || "").trim();

    const email =
      String(data.email || "").trim();

    const phone =
      String(data.phone || "").trim();

    const doctor =
      String(data.doctor || "").trim();

    const appointmentDate =
      String(data.appointmentDate || "").trim();

    const consultationFee =
      String(data.consultationFee || "").trim();


    // ------------------------------------------------------
    // VALIDATE PATIENT NAME
    // ------------------------------------------------------

    if (!patientName) {
      throw new Error(
        "Please enter patient name."
      );
    }


    // ------------------------------------------------------
    // VALIDATE EMAIL
    // ------------------------------------------------------

    if (!email) {
      throw new Error(
        "Please enter email address."
      );
    }

    if (
      !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
    ) {
      throw new Error(
        "Please enter a valid email address."
      );
    }


    // ------------------------------------------------------
    // VALIDATE PHONE
    // ------------------------------------------------------

    if (!/^[0-9]{10}$/.test(phone)) {

      throw new Error(
        "Please enter a valid 10 digit contact number."
      );

    }


    // ------------------------------------------------------
    // VALIDATE DOCTOR
    // ------------------------------------------------------

    if (!doctor) {

      throw new Error(
        "Please enter doctor name."
      );

    }


    // ------------------------------------------------------
    // VALIDATE APPOINTMENT DATE
    // ------------------------------------------------------

    if (!appointmentDate) {

      throw new Error(
        "Please select appointment date."
      );

    }


    // ------------------------------------------------------
    // VALIDATE CONSULTATION FEE
    // ------------------------------------------------------

    if (!consultationFee) {

      throw new Error(
        "Please enter consultation fee."
      );

    }


    // ------------------------------------------------------
    // CONVERT AMOUNT
    // ------------------------------------------------------

    const amount =
      parseFloat(
        consultationFee.replace(
          /[^0-9.]/g,
          ""
        )
      );


    if (
      isNaN(amount) ||
      amount <= 0
    ) {

      throw new Error(
        "Please enter a valid consultation fee."
      );

    }


    if (amount > 1000000) {

      throw new Error(
        "Consultation fee is too high."
      );

