// ==========================================================

function getStoredTransaction(txnid) {

  try {

    const ss =
      SpreadsheetApp.openById(
        SPREADSHEET_ID
      );


    const sheet =
      ss.getSheetByName(
        SHEET_NAME
      );


    if (!sheet) {

      return null;

    }


    const data =
      sheet
        .getDataRange()
        .getValues();


    // ======================================================
    // COLUMNS
    //
    // 0 Date
    // 1 Transaction ID
    // 2 Patient Name
    // 3 Email
    // 4 Contact Number
    // 5 Doctor
    // 6 Appointment Date
    // 7 Consultation Fee
    // 8 Payment Status
    // 9 PayU ID
    // 10 Bank Reference
    // ======================================================


    for (
      let i = 1;
      i < data.length;
      i++
    ) {

      if (
        String(data[i][1]) ===
        String(txnid)
      ) {

        return {

          row: i + 1,

          txnid:
            data[i][1],

          patientName:
            data[i][2],

          email:
            data[i][3],

          phone:
            data[i][4],

          doctor:
            data[i][5],

          appointmentDate:
            data[i][6],

          amount:
            data[i][7],

          status:
            data[i][8],

          mihpayid:
            data[i][9],

          bankReference:
            data[i][10]

        };

      }

    }


    return null;


  } catch (error) {

    console.log(
      "getStoredTransaction ERROR: " +
      error.message
    );

    return null;

  }

}


// ==========================================================
// 10. UPDATE PAYMENT STATUS
// ==========================================================

function updatePaymentStatus(

  txnid,

  status,

  mihpayid,

  bankRefNum

) {

  try {

    const ss =
      SpreadsheetApp.openById(
        SPREADSHEET_ID
      );


    const sheet =
      ss.getSheetByName(
        SHEET_NAME
      );


    if (!sheet) {

      return;

    }


    const data =
      sheet
        .getDataRange()
        .getValues();


    for (
      let i = 1;
      i < data.length;
      i++
    ) {

      if (
        String(data[i][1]) ===
        String(txnid)
      ) {

        // Column 9
        sheet
          .getRange(
            i + 1,
            9
          )
          .setValue(
            status
          );


        // Column 10
        if (mihpayid) {

          sheet
            .getRange(
              i + 1,
              10
            )
            .setValue(
              mihpayid
            );

        }


        // Column 11
        if (bankRefNum) {

          sheet
            .getRange(
              i + 1,
              11
            )
            .setValue(
              bankRefNum
            );

        }


        break;

      }

    }


  } catch (error) {

    console.log(
      "updatePaymentStatus ERROR: " +
      error.message
    );

  }

}


// ==========================================================
// 11. UPDATE CERTIFICATE DETAILS
// ==========================================================

function updateCertificateDetails(txnid, certificateNo, fileUrl) {

  try {

    const sheet = SpreadsheetApp
      .openById(SPREADSHEET_ID)
      .getSheetByName(SHEET_NAME);

    if (!sheet) {
      throw new Error("Appointments sheet not found.");
    }

    const data = sheet.getDataRange().getValues();

    for (let i = 1; i < data.length; i++) {

      // Column B = Transaction ID
      if (String(data[i][1]).trim() === String(txnid).trim()) {

        // Column L = Certificate No.
        sheet.getRange(i + 1, 12).setValue(certificateNo);

        // Column M = Certificate File
        sheet.getRange(i + 1, 13).setValue(fileUrl);

        // Column N = Certificate Sent
        sheet.getRange(i + 1, 14).setValue("YES");

        console.log(
          "Certificate details updated for: " + txnid
        );

        return true;
      }
    }

    console.log(
      "Certificate update: transaction not found: " + txnid
    );

    return false;

  } catch (error) {

    console.log(
      "updateCertificateDetails ERROR: " + error.message
    );

    throw error;
  }
}


// ==========================================================
// CHECK WHETHER CERTIFICATE WAS ALREADY SENT
// ==========================================================

function isCertificateSent(txnid) {

  try {

    const sheet = SpreadsheetApp
      .openById(SPREADSHEET_ID)
      .getSheetByName(SHEET_NAME);

    if (!sheet) {
      return false;
    }

    const data = sheet.getDataRange().getValues();

    for (let i = 1; i < data.length; i++) {

      // Column B = Transaction ID
      if (String(data[i][1]).trim() === String(txnid).trim()) {

        // Column N = Certificate Sent
        return String(data[i][13] || "").trim().toUpperCase() === "YES";
      }
    }

    return false;

  } catch (error) {

    console.log(
      "isCertificateSent ERROR: " + error.message
    );

    return false;
  }
}


