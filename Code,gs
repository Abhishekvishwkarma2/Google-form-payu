// ==========================================================
// 15. Certificate
// ==========================================================
function generateCertificate(data) {

  const folder = DriveApp.getFolderById(CERTIFICATE_FOLDER_ID);

  const certificateNo =
    "OMC-CERT-" +
    Utilities.formatDate(
      new Date(),
      "Asia/Kolkata",
      "yyyyMMddHHmmss"
    );

  const issueDate = Utilities.formatDate(
    new Date(),
    "Asia/Kolkata",
    "dd-MM-yyyy"
  );

  const template = HtmlService.createTemplateFromFile(
    "Certificate"
  );

  template.patientName = data.patientName;
  template.doctor = data.doctor;
  template.appointmentDate = data.appointmentDate;
  template.amount = data.amount;
  template.txnid = data.txnid;
  template.certificateNo = certificateNo;
  template.issueDate = issueDate;

  const html = template.evaluate().getContent();

  const pdfBlob = Utilities
    .newBlob(html, "text/html", certificateNo + ".html")
    .getAs("application/pdf")
    .setName(
      certificateNo +
      "_" +
      data.patientName +
      ".pdf"
    );

  const file = folder.createFile(pdfBlob);

  return {
    certificateNo: certificateNo,
    fileId: file.getId(),
    fileUrl: file.getUrl(),
    blob: pdfBlob
  };
}
