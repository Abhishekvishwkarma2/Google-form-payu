    // Always send amount with 2 decimals
    const formattedAmount =
      amount.toFixed(2);


    // ======================================================
    // GENERATE TRANSACTION ID
    // ======================================================

    const txnid =
      "OMC" +
      new Date().getTime() +
      Math.floor(
        Math.random() * 10000
