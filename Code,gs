    // ======================================================
    // PRODUCT INFORMATION
    // ======================================================

    const productinfo =
      "Doctor Appointment";


    // ======================================================
    // UDF FIELDS
    // ======================================================
    //
    // Keep UDF fields empty.
    //
    // Doctor and appointment date are stored
    // directly in Google Sheet.
    //
    // ======================================================

    const udf1 = "";
    const udf2 = "";
    const udf3 = "";
    const udf4 = "";
    const udf5 = "";


    // ======================================================
    // GET WEB APP URL
    // ======================================================

    const webAppUrl =
      ScriptApp
        .getService()
        .getUrl();


    if (!webAppUrl) {

      throw new Error(
        "Web App URL not found. Please deploy this project as a Web App."
      );

    }


    // ======================================================
    // PAYU REQUEST HASH
    // ======================================================
    //
    // key|txnid|amount|productinfo|firstname|email|
    // udf1|udf2|udf3|udf4|udf5||||||SALT
    //
    // ======================================================

   const si_details = "";

const hashString =
  PAYU_KEY + "|" +
