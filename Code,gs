// ==========================================================
// 5. SHA-512
// ==========================================================

function sha512(value) {

  const digest =
    Utilities.computeDigest(
      Utilities.DigestAlgorithm.SHA_512,
      value,
      Utilities.Charset.UTF_8
    );


  return digest
    .map(function(byte) {

      const v =
        byte < 0
          ? byte + 256
          : byte;

      return (
        "0" +
        v.toString(16)
      ).slice(-2);

    })
    .join("");

}


// ==========================================================
// 6. SAVE APPOINTMENT
// ==========================================================

function saveAppointment(data) {

  try {

    const ss =
      SpreadsheetApp.openById(
        SPREADSHEET_ID
      );


    let sheet =
      ss.getSheetByName(
        SHEET_NAME
      );


    // Create sheet if it does not exist
    if (!sheet) {

      sheet =
        ss.insertSheet(
          SHEET_NAME
        );

    }


    // ======================================================
    // HEADERS
    // ======================================================

    const headers = [

      "Date",

      "Transaction ID",

      "Patient Name",

      "Email",

      "Contact Number",

      "Doctor",

      "Appointment Date",

      "Consultation Fee",

      "Payment Status",

      "PayU ID",

      "Bank Reference",

      "Certificate No.",

      "Certificate File",

      "Certificate Sent"

    ];


    if (
      sheet.getLastRow() === 0
    ) {

      sheet
        .getRange(
          1,
          1,
          1,
          headers.length
        )
        .setValues([
          headers
        ]);

    }


    // ======================================================
    // SAVE
    // ======================================================

    sheet.appendRow([

      new Date(),

      data.txnid,

      data.patientName,

      data.email,

      data.phone,

      data.doctor,

      data.appointmentDate,

      data.amount,

      data.status,

      "",

      ""

    ]);


  } catch (error) {

    console.log(
      "saveAppointment ERROR: " +
      error.message
    );

  }

}


