          "",

          "",

          ""

        )

      );

  }

}


// ==========================================================
// 8. PAYU VERIFY PAYMENT API
// ==========================================================
//
// Hash:
//
// sha512(key|command|var1|salt)
//
// ==========================================================

function verifyPaymentWithPayU(txnid) {

  try {

    if (!txnid) {

      return {

        verified: false,

        status: "",

        amount: "",

        mihpayid: "",

        bankRefNum: "",

        message:
          "Transaction ID is missing."

      };

    }


    // ======================================================
    // COMMAND
    // ======================================================

    const command =
      "verify_payment";


    // ======================================================
    // VERIFY API HASH
    // ======================================================

    const verifyHashString =
      PAYU_KEY +
      "|" +
      command +
      "|" +
      txnid +
      "|" +
      PAYU_SALT;


    const verifyHash =
      sha512(
        verifyHashString
      );


    // ======================================================
    // API REQUEST
    // ======================================================

    const payload = {

      key: PAYU_KEY,

      command: command,

      var1: txnid,

      hash: verifyHash

    };


    console.log(
      "Calling PayU Verify API for: " +
      txnid
    );


    const response =
      UrlFetchApp.fetch(
        PAYU_VERIFY_URL,
        {

          method: "post",

          payload: payload,

          muteHttpExceptions: true,

          followRedirects: true

        }
      );


    const responseCode =
      response.getResponseCode();


    const responseText =
      response.getContentText();


    console.log(
      "PayU Verify HTTP Code: " +
      responseCode
    );

    console.log(
      "PayU Verify Response: " +
      responseText
    );


    if (
      !responseText
    ) {

      return {

        verified: false,

        status: "",

        amount: "",

        mihpayid: "",

        bankRefNum: "",

        message:
          "Empty response from PayU Verify API."

      };

    }


    // ======================================================
    // PARSE JSON
    // ======================================================

    let result;


    try {

      result =
        JSON.parse(
          responseText
        );

    } catch (jsonError) {

      return {

        verified: false,

        status: "",

        amount: "",

        mihpayid: "",

        bankRefNum: "",

        message:
          "Invalid JSON response from PayU: " +
          responseText.substring(
            0,
            500
          )

      };

    }


    // ======================================================
    // CHECK TRANSACTION DETAILS
    // ======================================================

    if (
      !result ||
      !result.transaction_details
    ) {

      return {

        verified: false,

        status: "",

        amount: "",

        mihpayid: "",

        bankRefNum: "",

        message:
          result &&
          result.msg
            ? result.msg
            : "Transaction details not returned by PayU."

      };

    }


    const transaction =
      result.transaction_details[
        txnid
      ];


    if (!transaction) {

      return {

        verified: false,

        status: "",

        amount: "",

        mihpayid: "",

        bankRefNum: "",

        message:
          "Transaction ID not found in PayU Verify response."

      };

    }


    // ======================================================
    // TRANSACTION VALUES
    // ======================================================

    const verifyStatus =
      String(
        transaction.status ||
        ""
      )
        .trim()
        .toLowerCase();


    // IMPORTANT:
    // PayU Verify API can return original amount
    // in "amt".

    const verifyAmount =
      String(
        transaction.amt ||
        transaction.amount ||
        transaction.transaction_amount ||
        ""
      ).trim();


    const verifyMihpayid =
      String(
        transaction.mihpayupid ||
        transaction.mihpayid ||
        ""
      ).trim();


    const verifyBankRef =
      String(
        transaction.bank_ref_num ||
        transaction.bank_ref_number ||
        ""
      ).trim();


    const verified =
      verifyStatus ===
      "success";


    return {

      verified: verified,

      status: verifyStatus,

      amount: verifyAmount,

      mihpayid: verifyMihpayid,

      bankRefNum: verifyBankRef,

      message:
        result.msg ||
        "Transaction verified."

    };


  } catch (error) {

    console.log(
      "verifyPaymentWithPayU ERROR: " +
      error.message
    );


    return {

      verified: false,

      status: "",

      amount: "",

      mihpayid: "",

      bankRefNum: "",

      message:
        error.message

    };

  }

}


